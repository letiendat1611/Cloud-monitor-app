{
  "name": "Azure Monitor Dev Container",
  
  "dockerComposeFile": "../docker/docker-compose.yml",
  "service": "api",
  "workspaceFolder": "/app",

  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-docker",
        
        // ── Added these two ────────────────────────────────
        "github.copilot",
        "github.copilot-chat",              // GitHub Copilot - AI code suggestions
        "cweijan.vscode-excel"         // View/edit Excel (.xlsx, .csv) files directly in VS Code
        // ──────────────────────────────────────────────────
      ]
    }
  },

  "postCreateCommand": "pip install -r requirements.txt"
}